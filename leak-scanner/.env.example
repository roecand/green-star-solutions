# --- Core (all optional for local dev; the app runs with zero keys) ---

# Database. Local SQLite file (default ./data/greenstar.db).
# On Railway, point this at the mounted persistent volume, e.g.
#   DATABASE_PATH=/data/greenstar.db
# DATABASE_PATH=./data/greenstar.db
#
# Optional hosted-SQLite (Turso) for disk-less hosts. Leave BOTH unset to use
# the local file above (the Railway deployment uses the file + a volume).
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-token

# Public URL of the app (used in emails and share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Funnel (lead-gen mode) ---

# Paid SaaS surface (pricing, upgrades, report gating) stays hidden while this
# is unset/false. Set to "true" only if you later want to sell subscriptions.
# NEXT_PUBLIC_BILLING_ENABLED=false

# The report's primary CTA ("Get My Personalized Fix Plan") opens this link
# (your scheduler — Calendly, GHL, etc.). If unset, the CTA still captures the
# lead and shows a "we'll reach out" confirmation instead of opening a link.
NEXT_PUBLIC_BOOKING_URL=

# Optional outbound webhook fired when a scan completes (e.g. GoHighLevel).
# Absent = no-op; never blocks a scan.
# LEAD_WEBHOOK_URL=

# Signups with this email get the admin role (Green Star admin bootstrap).
ADMIN_EMAIL=robert@greenstarsolutions.com

# Only needed if you seed an admin in production instead of signing up with
# ADMIN_EMAIL. Never ship the default password to production.
# SEED_ADMIN_PASSWORD=

# --- AI report generation (optional; deterministic fallback copy without it) ---
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-sonnet-5

# --- Email via Resend (optional; emails are logged + recorded without it) ---
# RESEND_API_KEY=re_...
# EMAIL_FROM="Green Star Scanner <scanner@green-starsolutions.com>"
# ADMIN_NOTIFICATION_EMAIL=robert@greenstarsolutions.com

# --- Stripe (billing is OFF by default; only used if NEXT_PUBLIC_BILLING_ENABLED=true) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_GROWTH=price_...
# STRIPE_PRICE_PRO=price_...

# =============================================================================
# Outbound prospecting engine (/outbound — admin only). Everything below is
# optional: with nothing set, the engine runs end-to-end in safe mode
# (deterministic analysis + template drafts, mock email provider).
# =============================================================================

# --- LLM (website analysis, outreach drafts, ambiguous reply classification) ---
# anthropic | openai | none. Default: anthropic if ANTHROPIC_API_KEY is set.
# OUTBOUND_LLM_PROVIDER=anthropic
# OUTBOUND_LLM_MODEL=claude-sonnet-5
# For any OpenAI-compatible endpoint (OpenAI, OpenRouter, Groq…):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Sender identity + compliance (REQUIRED before any real send) ---
# CAN-SPAM requires a valid physical postal address in every commercial email.
# OUTBOUND_SENDER_NAME=Robert
# OUTBOUND_SENDER_COMPANY=Greenstar Solutions
# OUTBOUND_SENDER_ADDRESS=123 Example St, Suite 100, Las Vegas, NV 89101
# NEXT_PUBLIC_APP_URL above must be the public URL — it's used in unsubscribe links.

# --- Scheduler ---
# Run the outbound scheduler inside the app every N seconds (set on Railway,
# e.g. 180). Leave unset in dev and press "Run now" instead. An external cron
# hitting /api/outbound/tick also works and is safe alongside it.
# OUTBOUND_SCHEDULER_INTERVAL_SECONDS=180

# --- Machine-to-machine secrets (generate with: openssl rand -hex 32) ---
# n8n/cron calls POST /api/outbound/tick with "Authorization: Bearer <this>".
# OUTBOUND_CRON_SECRET=
# Protects POST /api/outbound/webhooks/email (header or ?secret=).
# OUTBOUND_WEBHOOK_SECRET=

# --- Email provider: n8n (send from your own Workspace mailbox via n8n) ---
# OUTBOUND_N8N_SEND_WEBHOOK_URL=https://your-n8n.example.com/webhook/greenstar-send

# --- Email provider: Smartlead (sequence runs inside Smartlead) ---
# SMARTLEAD_API_KEY=

# --- GoHighLevel (Private Integration token for the sub-account) ---
# GHL_API_TOKEN=pit-...
# GHL_LOCATION_ID=
# Pipeline + stages are looked up BY NAME (GHL's UI never shows their ids).
# GHL_PIPELINE_NAME=Greenstar Outbound
# GHL_STAGE_INTERESTED_NAME=Interested
# GHL_STAGE_BOOKED_NAME=Call Booked
# Optional explicit overrides: GHL_PIPELINE_ID, GHL_STAGE_INTERESTED_ID, GHL_STAGE_BOOKED_ID
# GHL_API_VERSION=2021-07-28

# --- Notifications for interested/question replies (defaults to ADMIN_NOTIFICATION_EMAIL; needs RESEND_API_KEY to actually deliver) ---
# OUTBOUND_NOTIFY_EMAIL=robert@green-starsolutions.com
